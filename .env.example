# ProShield — Phase 4.1 runtime configuration (example)
# Copy to .env and adjust for your environment.
# Never commit a populated .env.

PROSHIELD_ENV=development
PROSHIELD_LOG_LEVEL=INFO

# MongoDB
PROSHIELD_MONGO_URI=mongodb://127.0.0.1:27017
PROSHIELD_MONGO_DB=proshield

# Ingestion limits
PROSHIELD_INGEST_MAX_BODY_BYTES=16384
PROSHIELD_INGEST_MAX_DETAILS_BYTES=8192
PROSHIELD_INGEST_RATE_LIMIT_PER_MINUTE=600

# Connector registration: comma-separated "name:module.path.to.ConnectorClass"
PROSHIELD_CONNECTORS=simulated:app.connectors.simulated:SimulatedConnector

# Phase 4.9 ingress boundary (trusted inbound telemetry)
# Source signing key: REQUIRED for production (fail-closed when missing).
# PROSHIELD_SOURCE_SIGNING_KEY=<32-byte hex>
PROSHIELD_INGRESS_REPLAY_STORE_REQUIRED=1
# MongoDB collection holding claimed single-use source-identity token ids
# (the production MongoReplayStore wired by scripts/ingress_server.py).
PROSHIELD_INGRESS_REPLAY_COLLECTION=source_token_replay
# Ingress listener backend (scripts/ingress_server.py): mongo | memory
# Production MUST use mongo so the replay store is cross-process safe.
PROSHIELD_INGRESS_BACKEND=mongo
